# =============================================================
# Yobou — Environment variables
# Copy this file to `.env` (server) and fill in real values.
# The Vite client only reads keys prefixed with VITE_.
# =============================================================

# ---------- server ----------
NODE_ENV=development
PORT=4000

# SQLite for dev (no install required). Swap to a Postgres URL for production,
# e.g. postgres://user:pass@host:5432/yobou
DATABASE_URL="file:./dev.db"

# Long random strings — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-please-use-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-too-this-is-separate-from-the-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Frontend origin allowed by CORS (Vite default)
CORS_ORIGIN=http://localhost:5173
# Session cookie is SameSite=None; Secure in production (apps on another
# domain / Android). Set to 1 on an HTTPS staging host to get the same.
# Leave unset for local http development.
CROSS_SITE_COOKIES=

# Local file storage for product images
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Simulated payment realism — % of card attempts that fail
PAYMENT_DECLINE_RATE=0.05

# Transactional email (password reset, order confirmation). Any SMTP
# provider works (Brevo, Mailgun, SendGrid, Gmail app password…).
# Leave SMTP_URL empty in development: emails are printed to the server log.
SMTP_URL=
MAIL_FROM="Yobou <no-reply@yourdomain.com>"

# Public URLs of the web apps, used for links inside emails. Defaults:
# localhost in development, the GitHub Pages pilot in production.
SHOPPER_URL=
PARTNER_URL=
ADMIN_URL=

# ---------- client (Vite — must start with VITE_) ----------
VITE_API_BASE=http://localhost:4000